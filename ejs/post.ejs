<!DOCTYPE html>
<html lang="uk">
    <%- include('./partials/head.ejs')%>
<body>
    <header>
        <%- include('./partials/nav.ejs')%>
        <h1>Деталі поста</h1>
    </header>
    <main>
        <article>
            <div class="info">
                <p><%= post.data || 'Нема дати' %></p>
