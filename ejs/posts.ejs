<!DOCTYPE html>
<html lang="uk">
    <%- include('./partials/head.ejs') %>
<body>
    <header>
        <%- include('./partials/nav.ejs') %>
        <h1>Список постів</h1>
    </header>
    <main>
        <ul>
            <% if (posts.length) { %>
                <% posts.forEach(({ id, text, title, data, author }) => { %>
                    <li>
                        <article>
                            <h2>
                                <a href="/post/<%= id %>"><%= title %></a>
                            </h2>
                            <p><%= text %></p>
                            <div class="info">
                                <span><%= data %></span>
                                <span><%= author %></span>
                            </div>
                        </article>
                    </li>
                <% }) %>
            <% } else { %>
                <li>Постів поки що немає.</li>
            <% } %>
        </ul>
    </main>
    <footer>
        <p>&copy; 2025 Блог</p>
    </footer>
</body>
</html>
