<!DOCTYPE html>
<html lang="uk">
    <%- include('./partials/head.ejs')%>
<body>
    <header>
        <%- include('./partials/nav.ejs')%>
        <h1>Контакти</h1>
    </header>
    <main>
        <ul class="contacts-list">
            <% if (contacts.length) { %>
                <% contacts.forEach(({link, name}) => { %>
                    <li>
                        <a href="<%= link%>"><%= name%></a>
                    </li>
                <% }) %>
            <% }%>
        </ul>
    </main>
    <footer>
        <p>&copy; 2025 Блог</p>
    </footer>
</body>
</html>
